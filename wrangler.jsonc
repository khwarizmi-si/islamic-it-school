{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "islamic-it-school",
	"account_id": "1ef2e18dc9de53cb201f3ca19b77bebb",
	"compatibility_date": "2026-09-22",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [{ "pattern": "itmi.khwarizmi.co.id", "custom_domain": true }],
	"workers_dev": true,
	"preview_urls": true
}
